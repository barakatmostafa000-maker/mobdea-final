{
  "name": "mobdea-mobile",
  "private": true,
  "version": "10.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/lint-source.mjs",
    "format:check": "node scripts/check-format.mjs",
    "verify:static": "node scripts/sync-version.mjs && node scripts/verify-project.mjs",
    "verify": "npm run test && npm run lint && npm run format:check && npm run verify:static && npm run build",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:prepare": "npm run cap:sync",
    "android:debug": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:prepare && cd android && ./gradlew bundleRelease assembleRelease",
    "release:prepare": "npm run verify && npx cap sync android",
    "verify:release": "npm run verify"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "^4.4.1",
    "@xmldom/xmldom": "^0.9.10",
    "fake-indexeddb": "^6.2.5",
    "vite": "^6.1.0"
  },
  "mobdea": {
    "versionCode": 116
  }
}
