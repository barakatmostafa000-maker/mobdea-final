/* RC38: dashboard / lock-screen / map enhancements */
.lock-screen{
  position:relative;
  min-height:100vh;
  overflow:hidden;
  background:
    radial-gradient(circle at 20% 20%, rgba(215,173,53,.18), transparent 22%),
    radial-gradient(circle at 80% 15%, rgba(85,58,18,.25), transparent 22%),
    linear-gradient(135deg, #08090d 0%, #0f1117 38%, #1c150d 100%);
  color:#f7e8b1;
  padding:24px;
}
.lock-screen-glow{
  position:absolute;
  inset:auto;
  width:340px;
  height:340px;
  border-radius:50%;
  filter:blur(12px);
  opacity:.45;
  pointer-events:none;
}
.lock-glow-1{top:-80px;left:-90px;background:rgba(215,173,53,.12)}
.lock-glow-2{right:-100px;bottom:-120px;background:rgba(255,200,100,.08)}
.lock-screen-layout{
  position:relative;
  z-index:1;
  display:grid;
  grid-template-columns:minmax(0,1.2fr) minmax(330px,.78fr);
  gap:22px;
  align-items:center;
  min-height:calc(100vh - 48px);
  max-width:1500px;
  margin:0 auto;
}
.lock-hero-panel,
.lock-card{
  border:1px solid rgba(255, 213, 123, .18);
  box-shadow:0 28px 80px rgba(0,0,0,.38);
  backdrop-filter:blur(10px);
}
.lock-hero-panel{
  position:relative;
  overflow:hidden;
  min-height:calc(100vh - 48px);
  padding:28px;
  border-radius:30px;
  display:grid;
  grid-template-rows:auto auto minmax(260px,1fr) auto auto;
  gap:20px;
  background:linear-gradient(180deg, rgba(11,13,18,.82), rgba(23,17,10,.72));
}
.lock-brand-chip{
  width:fit-content;
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:9px 14px;
  border-radius:999px;
  border:1px solid rgba(255, 214, 124, .2);
  background:rgba(255,255,255,.05);
  color:#f4d06a;
  font-weight:800;
}
.lock-hero-copy h1{
  margin:10px 0 12px;
  font-size:clamp(40px, 6vw, 70px);
  line-height:1.05;
  color:#f3cf71;
}
.lock-hero-kicker{
  margin:0;
  display:inline-flex;
  align-items:center;
  gap:8px;
  color:#ffd56f;
  font-size:13px;
  font-weight:800;
  letter-spacing:.2px;
}
.lock-hero-text{
  margin:0;
  max-width:700px;
  color:#e9e0ca;
  line-height:1.9;
  font-size:17px;
}
.lock-hero-portrait{
  position:relative;
  border-radius:28px;
  overflow:hidden;
  min-height:320px;
  border:1px solid rgba(255, 214, 124, .18);
  background:linear-gradient(180deg, rgba(0,0,0,.18), rgba(0,0,0,.42));
}
.lock-avatar{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center top;
  display:block;
  filter:saturate(1.02) contrast(1.02);
}
.lock-portrait-ribbon{
  position:absolute;
  right:16px;
  left:16px;
  bottom:14px;
  display:inline-flex;
  align-items:center;
  gap:8px;
  width:fit-content;
  padding:9px 12px;
  border-radius:999px;
  background:rgba(6,8,12,.75);
  border:1px solid rgba(255, 214, 124, .2);
  color:#f0d478;
}
.lock-role-grid{
  display:grid;
  grid-template-columns:repeat(4, minmax(0,1fr));
  gap:10px;
}
.lock-role-grid button{
  border:1px solid rgba(255,255,255,.08);
  background:rgba(255,255,255,.04);
  color:#f6e4b3;
  border-radius:18px;
  padding:14px 10px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  font-weight:800;
}
.lock-role-grid button.active{
  background:linear-gradient(145deg, rgba(239,194,93,.95), rgba(181,126,23,.95));
  color:#10131a;
  box-shadow:0 8px 24px rgba(215,173,53,.25);
}
.lock-hero-stats{
  display:grid;
  grid-template-columns:repeat(3, minmax(0,1fr));
  gap:10px;
}
.lock-hero-stats div{
  padding:14px;
  border-radius:18px;
  border:1px solid rgba(255,214,124,.16);
  background:rgba(255,255,255,.04);
  display:grid;
  gap:5px;
}
.lock-hero-stats strong{
  color:#ffd770;
  font-size:24px;
}
.lock-hero-stats span{
  color:#d7d0be;
  font-size:12px;
}
.lock-card{
  position:relative;
  z-index:1;
  display:grid;
  gap:18px;
  padding:26px;
  border-radius:28px;
  background:linear-gradient(180deg, rgba(13,15,20,.92), rgba(8,10,14,.94));
}
.lock-card-header{
  display:flex;
  align-items:center;
  gap:14px;
}
.lock-card-badge{
  width:72px;
  height:72px;
  border-radius:20px;
  object-fit:cover;
  border:1px solid rgba(255,214,124,.2);
}
.lock-card-header h2{
  margin:0;
  font-size:22px;
  color:#f3cf71;
}
.lock-card-header p{
  margin:4px 0 0;
  color:#cfd7e4;
}
.lock-card-title h3{
  margin:0 0 8px;
  font-size:28px;
  color:#f6e09c;
}
.lock-card-title p{
  margin:0;
  color:#d5d0bf;
  line-height:1.7;
}
.lock-pin-label{
  display:grid;
  gap:9px;
}
.lock-pin-label span{font-weight:800;color:#e9d08a}
.lock-pin-label input{
  width:100%;
  font-size:26px;
  letter-spacing:8px;
  text-align:center;
  padding:14px 14px;
  border-radius:16px;
  color:#fff;
  border:1px solid rgba(255,214,124,.2);
  background:rgba(255,255,255,.05);
  outline:none;
}
.lock-pin-label input:focus{
  border-color:#f1d77a;
  box-shadow:0 0 0 3px rgba(215,173,53,.16);
}
.lock-submit{
  width:100%;
  padding-block:14px;
  border-radius:16px;
}
.lock-card-footer{
  display:grid;
  gap:4px;
}
.lock-card-footer small{
  color:#b9c3d2;
}
.lock-error{
  display:block;
  color:#ff8f8f;
  background:rgba(255, 71, 71, .08);
  border:1px solid rgba(255, 71, 71, .15);
  padding:10px 12px;
  border-radius:12px;
}

.dashboard-hero{
  grid-template-columns:minmax(0,1.08fr) minmax(300px,.75fr) minmax(275px,.72fr);
  gap:18px;
}
.hero-copy{display:grid;align-content:start}
.hero-info-strip{
  display:grid;
  grid-template-columns:repeat(4, minmax(0,1fr));
  gap:10px;
  margin-top:22px;
}
.dashboard-mini-stat{
  padding:12px 13px;
  border-radius:16px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.08);
}
.dashboard-mini-stat strong{display:block;color:#f3cf71;font-size:18px}
.dashboard-mini-stat span{display:block;color:#d0d7e3;font-size:11px;margin-top:3px}
.hero-visual{
  position:relative;
  min-height:340px;
  border-radius:28px;
  overflow:hidden;
  border:1px solid rgba(255,214,124,.14);
  background:radial-gradient(circle at 65% 30%, rgba(215,173,53,.32), transparent 28%), linear-gradient(145deg, #0a0c11, #1f160c 80%);
}
.hero-visual-map{
  position:absolute;
  inset:0;
  background:
    linear-gradient(180deg, rgba(0,0,0,.2), rgba(0,0,0,.5)),
    url('/identity/mostafa-barakat.jpg') center/cover no-repeat;
  opacity:.27;
  filter:sepia(.9) saturate(.6) contrast(.9);
}
.hero-visual-portrait{
  position:absolute;
  right:22px;
  bottom:0;
  width:min(52%, 300px);
  height:92%;
  object-fit:cover;
  object-position:center top;
  filter:saturate(1.03) contrast(1.03);
}
.hero-visual-copy{
  position:absolute;
  left:18px;
  right:18px;
  bottom:16px;
  display:grid;
  gap:2px;
  max-width:260px;
}
.hero-visual-copy span{color:#f0d478;font-size:12px;font-weight:800}
.hero-visual-copy strong{font-size:21px;color:#fff}
.hero-visual-copy small{color:#cdd6e2;font-size:12px}
.hero-session-card{
  display:grid;
  gap:12px;
  align-self:stretch;
}
.hero-session-list{
  display:grid;
  gap:9px;
}
.hero-session-row{
  padding:11px 12px;
  border-radius:14px;
  border:1px solid rgba(255,255,255,.08);
  background:rgba(255,255,255,.04);
  display:grid;
  gap:3px;
}
.hero-session-row strong{color:#f3cf71;font-size:14px}
.hero-session-row span{color:#d6dde8;font-size:12px}
.hero-upcoming-box{
  padding:12px;
  border-radius:16px;
  border:1px solid rgba(255,214,124,.14);
  background:rgba(255,255,255,.04);
  display:grid;
  gap:6px;
}
.hero-upcoming-box span{color:#f3cf71;font-size:12px;font-weight:800}
.hero-upcoming-box strong{color:#fff;font-size:14px}

