/* RC36: student card print polish */
.front-hero-footer{
  position:absolute;
  left:14px;
  right:14px;
  bottom:14px;
  display:grid;
  gap:4px;
  justify-items:start;
  pointer-events:none;
}
.front-hero-mark{
  color:#f3d77a;
  font-size:12px;
  font-weight:900;
  letter-spacing:.4px;
}
.front-hero-caption{
  color:#f3d77a;
  font-size:10px;
  opacity:.92;
}
.front-hero-sub{
  color:#fff;
  font-size:8px;
  opacity:.85;
}
.print-mode-group{
  display:grid;
  gap:8px;
}
.print-mode-group>span{
  color:var(--muted);
  font-size:12px;
  font-weight:900;
}
.side-toggle-group.compact{
  flex-wrap:wrap;
}
.side-toggle-group.compact button{
  padding-inline:12px;
  font-size:12px;
}
.print-run{
  display:grid;
  gap:10px;
}
.print-run-header{
  display:flex;
  justify-content:space-between;
  gap:12px;
  align-items:flex-end;
}
.print-run-header h2{
  margin:0;
  font-size:22px;
}
.print-run-header p{
  margin:0;
  color:var(--muted);
}
.print-run-separator{
  height:0;
  border-top:2px dashed #d6dbe3;
  margin:6px 0 14px;
}
@media print{
  @page{
    size:auto;
    margin:8mm;
  }
  body{
    background:#fff !important;
  }
  body *{
    visibility:hidden !important;
  }
  .print-only,
  .print-only *{
    visibility:visible !important;
  }
  .print-only{
    display:block !important;
    position:absolute !important;
    inset:0 !important;
    padding:0 !important;
    margin:0 !important;
  }
  .print-run{
    break-after:page;
    page-break-after:always;
  }
  .print-run:last-child{
    break-after:auto;
    page-break-after:auto;
  }
  .print-run-separator{
    break-after:page;
    page-break-after:always;
  }
  .no-print{
    display:none !important;
  }
}


