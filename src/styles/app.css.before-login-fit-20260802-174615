   This block intentionally wins over legacy layered patches.
   ========================================================= */
:root{
  --mobdea-gold:#d7ad35;
  --mobdea-gold-soft:#f0d478;
  --mobdea-ink:#090b10;
  --mobdea-panel:#111723;
