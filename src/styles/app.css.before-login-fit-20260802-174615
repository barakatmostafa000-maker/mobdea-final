.dashboard-reference-layout {
  width: 100%;
  max-width: none;
  min-height: 100vh;
  padding: 0 14px 16px;
  color: #f8ead0;
  background:
    radial-gradient(circle at 52% 18%,rgba(177,102,24,.08),transparent 28%),
    linear-gradient(180deg,#080807 0%,#0d0b08 55%,#070706 100%);
}
.dashboard-desktop-topbar {
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 13px 8px;
  border-bottom: 1px solid rgba(215,173,53,.13);
}
.dashboard-search-wrap {
  width: min(520px,48vw);
  height: 48px;
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 15px;
  border-radius: 12px;
  background: rgba(11,11,10,.93);
  border: 1px solid rgba(215,173,53,.27);
  color: #d6a23d;
  z-index: 25;
}
.dashboard-search-wrap input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #fff5df;
  font-size: 1rem;
}
.dashboard-search-wrap > button,
.dashboard-search-results-head button {
  border: 0;
  background: transparent;
  color: #d8b56d;
  display: grid;
  place-items: center;
}
.dashboard-search-results {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  left: 0;
  padding: 8px;
  border-radius: 14px;
  background: rgba(10,10,9,.98);
  border: 1px solid rgba(215,173,53,.28);
  box-shadow: 0 24px 50px #000b;
}
.dashboard-search-results-head { display: flex; justify-content: space-between; padding: 7px 8px 10px; color: #e8c373; }
.dashboard-search-results > button {
  width: 100%;
  display: grid;
  grid-template-columns: 32px minmax(0,1fr) auto;
  align-items: center;
  gap: 9px;
  padding: 9px;
  border: 0;
  border-radius: 10px;
  text-align: right;
  color: #f7ecd5;
  background: transparent;
}
.dashboard-search-results > button:hover { background: rgba(215,173,53,.1); }
.dashboard-search-results > button span:nth-child(2) { display: grid; gap: 2px; }
.dashboard-search-results small { color: #a8997d; }
.dashboard-search-result-icon { width: 30px; height: 30px; display: grid; place-items: center; color: #e1ae49; background: rgba(215,173,53,.1); border-radius: 8px; }
.dashboard-search-empty { padding: 15px; text-align: center; color: #a89c84; }
.dashboard-account-strip { display: flex; align-items: center; gap: 14px; }
.dashboard-bell {
  position: relative;
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: #e1b75f;
  border-left: 1px solid rgba(215,173,53,.14);
}
.dashboard-bell b { position: absolute; top: 1px; right: 2px; width: 19px; height: 19px; border-radius: 50%; display: grid; place-items: center; background: #c5332e; color: #fff; font-size: 10px; }
.dashboard-account { display: flex; align-items: center; gap: 10px; border: 0; background: transparent; color: #f3e6ca; text-align: right; }
.dashboard-account span { display: grid; gap: 2px; }
.dashboard-account small { color: #a99a7c; }
.dashboard-account img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 1px solid #b88328; }

.dashboard-reference-hero {
  min-height: 430px;
  display: grid;
  grid-template-columns: minmax(340px,1.15fr) minmax(350px,.95fr) minmax(260px,.78fr);
  overflow: hidden;
  position: relative;
  border: 1px solid rgba(215,173,53,.18);
  border-radius: 0 0 18px 18px;
  background:
    linear-gradient(90deg,rgba(2,2,2,.98) 0%,rgba(13,9,6,.88) 35%,rgba(12,9,7,.35) 68%,rgba(3,3,3,.93) 100%),
    repeating-linear-gradient(90deg,rgba(115,73,33,.06) 0,rgba(115,73,33,.06) 1px,transparent 1px,transparent 54px),
    #0b0907;
}
.dashboard-reference-copy {
  position: relative;
  z-index: 3;
  align-self: center;
  padding: 34px 38px;
}
.dashboard-reference-kicker { display: block; color: #e6b85b; font-size: 1.8rem; font-weight: 800; }
.dashboard-reference-copy h2 {
  margin: -2px 0 0;
  font-size: clamp(4.5rem,7vw,7.2rem);
  line-height: .95;
  color: #e5ad43;
  text-shadow: 0 5px 24px #000;
}
.dashboard-reference-copy h3 { margin: 14px 0 18px; font-size: 2.2rem; color: #d99d36; }
.dashboard-reference-copy p { max-width: 560px; margin: 0; line-height: 2; color: #ede5d8; font-size: 1.05rem; }
.dashboard-reference-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 25px; }
.dashboard-reference-cta button { min-height: 48px; padding: 0 24px; border-radius: 9px; display: inline-flex; align-items: center; gap: 10px; }
.dashboard-reference-portrait { position: relative; min-height: 430px; overflow: hidden; }
.dashboard-reference-portrait > img { position: absolute; z-index: 3; right: 13%; bottom: -10px; width: min(88%,430px); height: 90%; object-fit: cover; object-position: center top; filter: saturate(.83) contrast(1.07); border-radius: 45% 45% 8px 8px; -webkit-mask-image: linear-gradient(180deg,#000 82%,transparent 100%); mask-image: linear-gradient(180deg,#000 82%,transparent 100%); }
.dashboard-map-paper { position: absolute; top: 0; right: -8%; left: 16%; height: 72%; padding: 20px; color: #21160d; text-align: center; background:
  radial-gradient(circle at 25% 45%,transparent 0 8%,rgba(61,36,16,.26) 8.5% 9%,transparent 9.5%),
  repeating-radial-gradient(ellipse at 60% 50%,rgba(77,43,17,.2) 0 1px,transparent 2px 18px),
  linear-gradient(135deg,#a36d2f,#6f421f 48%,#b17b3b);
  opacity: .72;
  transform: perspective(600px) rotateY(-6deg);
}
.dashboard-map-paper span,.dashboard-map-paper small { display: block; font-weight: 900; }
.dashboard-banner { position: absolute; z-index: 2; top: 30px; left: 4%; width: 115px; min-height: 185px; padding: 16px 10px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; gap: 16px; text-align: center; color: #b8782e; background: linear-gradient(180deg,#12100e,#090807); border: 1px solid rgba(180,116,41,.5); }
.dashboard-banner span { writing-mode: vertical-rl; font-size: 1.3rem; }
.dashboard-history-books { position: absolute; z-index: 4; bottom: 20px; left: 0; display: grid; gap: 4px; transform: rotate(-4deg); }
.dashboard-history-books span { padding: 7px 18px; border-radius: 4px; color: #d6a956; background: linear-gradient(90deg,#2d1b0e,#4b2b13,#26160b); border: 1px solid #7b4b20; box-shadow: 0 5px 8px #0008; }
.dashboard-today-panel { margin: 14px; padding: 18px; align-self: stretch; border-radius: 14px; background: rgba(10,10,9,.94); border: 1px solid rgba(215,173,53,.24); box-shadow: 0 20px 40px #0007; }
.dashboard-today-head { display: flex; align-items: center; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid rgba(215,173,53,.13); color: #e7b95b; }
.dashboard-today-head div { display: grid; gap: 4px; }
.dashboard-today-head strong { font-size: 1.3rem; color: #fff0cf; }
.dashboard-today-head small { color: #c99b42; }
.dashboard-today-list { display: grid; gap: 3px; padding: 12px 0; }
.dashboard-today-list > button { width: 100%; min-height: 52px; display: grid; grid-template-columns: 36px minmax(0,1fr) auto; align-items: center; gap: 8px; border: 0; border-bottom: 1px solid rgba(255,255,255,.05); color: #eee4d1; background: transparent; text-align: right; }
.dashboard-today-list > button:hover { background: rgba(215,173,53,.07); }
.dashboard-today-list small { color: #d2c6af; direction: rtl; }
.schedule-dot { width: 30px; height: 30px; border-radius: 8px; display: grid; place-items: center; color: #fff; }
.schedule-dot.tone-1 { background: #1974a8; }.schedule-dot.tone-2 { background: #2c8848; }.schedule-dot.tone-3 { background: #b96c12; }.schedule-dot.tone-4 { background: #7b3fa1; }
.dashboard-full-schedule { width: 100%; min-height: 45px; display: flex; justify-content: center; align-items: center; gap: 9px; border-radius: 9px; border: 1px solid rgba(215,173,53,.28); color: #e8bd65; background: transparent; }
.dashboard-today-empty { padding: 18px; text-align: center; color: #a59577; }

.dashboard-feature-grid { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 12px; padding: 14px 5px; }
.dashboard-feature-card { min-height: 230px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 16px 12px; border-radius: 14px; border: 1px solid rgba(215,173,53,.18); color: #f6ead0; background: linear-gradient(180deg,#141310,#0c0c0b); box-shadow: inset 0 1px rgba(255,255,255,.03),0 12px 25px #0004; text-align: center; }
.dashboard-feature-card:hover { transform: translateY(-3px); border-color: rgba(215,173,53,.45); }
.dashboard-feature-icon { width: 58px; height: 58px; border-radius: 12px; display: grid; place-items: center; color: #fff; }
.dashboard-feature-card.violet .dashboard-feature-icon { background: linear-gradient(145deg,#7532a5,#3c175a); }.dashboard-feature-card.green .dashboard-feature-icon { background: linear-gradient(145deg,#4d9f5c,#205c2a); }.dashboard-feature-card.blue .dashboard-feature-icon { background: linear-gradient(145deg,#187bb0,#0a496f); }.dashboard-feature-card.red .dashboard-feature-icon { background: linear-gradient(145deg,#b8403c,#6b1c1a); }.dashboard-feature-card.amber .dashboard-feature-icon { background: linear-gradient(145deg,#be862e,#765015); }.dashboard-feature-card.orange .dashboard-feature-icon { background: linear-gradient(145deg,#bd721a,#6e3c0b); }
.dashboard-feature-card strong { font-size: 1.2rem; color: #e5b75b; }
.dashboard-feature-card small { min-height: 43px; color: #c8c0b1; line-height: 1.65; }
.dashboard-feature-link { margin-top: 4px; width: 100%; min-height: 38px; display: flex; justify-content: center; align-items: center; gap: 8px; border: 1px solid rgba(215,173,53,.2); border-radius: 8px; color: #d9a94c; }

.dashboard-reference-bottom { display: grid; grid-template-columns: 1.05fr 1fr 1fr; gap: 12px; padding: 0 5px; }
.dashboard-current-class-card,.dashboard-lower-panel { min-height: 208px; border-radius: 14px; border: 1px solid rgba(215,173,53,.18); background: linear-gradient(180deg,#12110f,#090908); }
.dashboard-current-class-card { display: grid; grid-template-columns: 135px minmax(0,1fr); grid-template-rows: 1fr auto; gap: 8px 14px; padding: 16px; }
.dashboard-current-art { grid-row: 1/3; border-radius: 12px; display: grid; place-content: center; gap: 9px; color: #ba772a; background: radial-gradient(circle,#3f2815,#130e09 68%); border: 1px solid rgba(177,107,34,.32); }
.dashboard-current-class-card span,.dashboard-lower-title { color: #e4b459; }
.dashboard-current-class-card h3 { margin: 7px 0; color: #fff2d5; }
.dashboard-current-class-card p { margin: 0; color: #beb29f; }
.dashboard-current-class-card > div:nth-child(2) > strong { display: block; margin-top: 10px; color: #e2a747; font-size: 1.5rem; direction: ltr; text-align: right; }
.dashboard-current-class-card > button,.dashboard-lower-link { min-height: 36px; border-radius: 8px; border: 1px solid rgba(215,173,53,.2); color: #e4b45b; background: transparent; }
.dashboard-lower-panel { padding: 14px; display: grid; grid-template-rows: auto 1fr auto; }
.dashboard-lower-title { display: flex; align-items: center; justify-content: center; gap: 8px; padding-bottom: 10px; border-bottom: 1px solid rgba(215,173,53,.13); }
.dashboard-announcement-list { display: grid; align-content: center; gap: 8px; padding: 8px 0; }
.dashboard-announcement-list > button { display: grid; grid-template-columns: 8px minmax(0,1fr); gap: 9px; align-items: center; padding: 7px 4px; border: 0; background: transparent; text-align: right; color: #f3e8d2; }
.dashboard-announcement-list i { width: 8px; height: 8px; border-radius: 50%; background: #d9a22f; }.dashboard-announcement-list i.red { background: #d6423d; }.dashboard-announcement-list i.orange { background: #ef8c22; }
.dashboard-announcement-list span { display: grid; gap: 3px; }.dashboard-announcement-list small { color: #a99e89; }
.dashboard-hidden-live-metrics { display: none; }

/* Standalone reference whiteboard */
.whiteboard-page {
  width: 100%; max-width: none; min-height: 100vh; padding: 8px; color: #f8e8bf;
  background: radial-gradient(circle at 50% 0%,rgba(151,91,28,.16),transparent 24%),linear-gradient(180deg,#0e0b08,#080706);
}
.whiteboard-page.css-fullscreen { position: fixed; inset: 0; z-index: 900; overflow: auto; }
.whiteboard-reference-header { min-height: 118px; display: grid; grid-template-columns: 260px minmax(300px,1fr) 310px; align-items: center; gap: 14px; padding: 9px 16px; border: 1px solid rgba(215,173,53,.32); border-radius: 16px 16px 0 0; background:
  linear-gradient(90deg,rgba(19,13,8,.98),rgba(139,90,39,.72),rgba(34,20,11,.95)),
  repeating-linear-gradient(30deg,transparent 0 13px,rgba(0,0,0,.12) 14px 15px);
}
.whiteboard-brand-flag,.whiteboard-teacher-card { display: flex; align-items: center; gap: 12px; }
.whiteboard-brand-flag img { width: 74px; height: 74px; object-fit: contain; }
.whiteboard-brand-flag div,.whiteboard-teacher-card div { display: grid; gap: 4px; }
.whiteboard-brand-flag strong { color: #e2ab43; font-size: 2rem; }.whiteboard-brand-flag small { color: #deb75e; }
.whiteboard-title-plaque { justify-self: center; min-width: min(440px,100%); padding: 13px 34px; text-align: center; border: 2px solid #7f5124; outline: 1px solid #d2a34e; outline-offset: 4px; border-radius: 8px; background: linear-gradient(180deg,#1a100a,#080706); box-shadow: 0 8px 20px #0008; }
.whiteboard-title-plaque span { display: block; font-size: 2rem; color: #e3ad4a; font-weight: 900; }.whiteboard-title-plaque small { color: #d7c19b; }
.whiteboard-teacher-card { justify-content: flex-start; }.whiteboard-teacher-card img { width: 92px; height: 92px; border-radius: 50%; object-fit: cover; border: 3px solid #b8792f; box-shadow: 0 0 0 3px #24150b; }.whiteboard-teacher-card strong { color: #e1ad4b; font-size: 1.25rem; }.whiteboard-teacher-card small { color: #d3c09c; }
.whiteboard-reference-layout { display: grid; grid-template-columns: 92px minmax(0,1fr) 285px; gap: 8px; min-height: calc(100vh - 190px); border-left: 1px solid rgba(215,173,53,.25); border-right: 1px solid rgba(215,173,53,.25); background: #070605; }
.whiteboard-tool-rail { padding: 12px 7px; display: flex; flex-direction: column; gap: 3px; background: linear-gradient(180deg,#17110c,#090706); border-left: 1px solid rgba(215,173,53,.18); }
.whiteboard-tool-rail button { min-height: 54px; border: 0; border-bottom: 1px solid rgba(215,173,53,.12); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: #d8c7a8; background: transparent; font-size: .72rem; }
.whiteboard-tool-rail button:hover,.whiteboard-tool-rail button.active { color: #f0c46a; background: rgba(215,173,53,.1); }.whiteboard-tool-rail button:disabled { opacity: .35; }
.whiteboard-rail-divider { height: 1px; background: rgba(215,173,53,.25); margin: 5px 4px; }
.whiteboard-paper-stage { min-width: 0; position: relative; display: grid; grid-template-rows: auto minmax(0,1fr) auto; background: #15100b; }
.whiteboard-resource-strip { min-height: 44px; display: flex; justify-content: space-between; gap: 10px; padding: 7px 10px; background: #0c0907; border-bottom: 1px solid rgba(215,173,53,.17); }
.whiteboard-resource-strip label { flex: 1; display: flex; align-items: center; gap: 8px; color: #dba747; }.whiteboard-resource-strip select { width: min(500px,100%); min-height: 32px; border-radius: 8px; border: 1px solid rgba(215,173,53,.22); background: #17110d; color: #f4e5c3; padding: 0 9px; }
.whiteboard-shape-picker { display: flex; gap: 5px; }.whiteboard-shape-picker button { width: 34px; border-radius: 7px; border: 1px solid rgba(215,173,53,.18); color: #d9b260; background: transparent; }.whiteboard-shape-picker button.active { background: #d7ad35; color: #111; }
.whiteboard-canvas-viewport { position: relative; overflow: auto; min-height: 650px; padding: 16px; display: grid; place-items: center; background: radial-gradient(circle,#2b1d11,#0e0a07 72%); }
.whiteboard-canvas-stack { position: relative; width: 100%; max-width: 1400px; aspect-ratio: 1400/850; transform-origin: center; border: 8px solid #5a3518; outline: 2px solid #b3742e; background:
  radial-gradient(circle at 12% 18%,rgba(127,91,42,.07),transparent 18%),
  repeating-linear-gradient(0deg,rgba(98,74,39,.035) 0 1px,transparent 1px 30px),
  #f4ecd9;
  box-shadow: inset 0 0 40px rgba(101,65,28,.18),0 20px 45px #0008;
}
.whiteboard-background-media,.whiteboard-drawing-canvas { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }.whiteboard-background-media { object-fit: contain; z-index: 1; background: #f4ecd9; }.whiteboard-drawing-canvas { z-index: 2; touch-action: none; cursor: crosshair; }
.whiteboard-bottom-toolbar { min-height: 64px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: center; padding: 8px 13px; background: #0d0a08; border-top: 1px solid rgba(215,173,53,.18); }
.whiteboard-stroke-controls,.whiteboard-page-controls,.whiteboard-view-controls { display: flex; align-items: center; gap: 7px; }.whiteboard-stroke-controls button { width: 26px; height: 26px; padding: 0; border-radius: 50%; border: 2px solid #2b241d; }.whiteboard-stroke-controls button.active { outline: 2px solid #d7ad35; outline-offset: 2px; }.whiteboard-stroke-controls select { min-height: 32px; border-radius: 7px; background: #16110d; border: 1px solid #5c452c; color: #f4dfb8; }
.whiteboard-page-controls { justify-content: center; padding: 5px 12px; border-radius: 12px; background: #17110d; border: 1px solid rgba(215,173,53,.16); }.whiteboard-page-controls button,.whiteboard-view-controls button { min-height: 34px; display: inline-flex; align-items: center; gap: 5px; border-radius: 8px; border: 1px solid rgba(215,173,53,.18); color: #e4bd6a; background: transparent; }.whiteboard-view-controls { justify-content: flex-end; }.whiteboard-view-controls .danger { color: #ff9b8d; border-color: rgba(214,66,61,.4); }
.whiteboard-notice { position: absolute; z-index: 20; right: 50%; bottom: 78px; transform: translateX(50%); max-width: 80%; padding: 10px 15px; border-radius: 10px; border: 1px solid rgba(215,173,53,.35); background: rgba(6,5,4,.94); color: #efc873; box-shadow: 0 15px 35px #0008; }
.whiteboard-students-panel { display: grid; grid-template-rows: auto 1fr auto; min-width: 0; background: linear-gradient(180deg,#16100b,#080706); border-right: 1px solid rgba(215,173,53,.18); }
.whiteboard-students-head { min-height: 58px; display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; color: #e0ad4e; border-bottom: 1px solid rgba(215,173,53,.18); }.whiteboard-students-head small { color: #a9936d; }
.whiteboard-students-list { overflow: auto; padding: 8px; }.whiteboard-students-list > div { min-height: 46px; display: grid; grid-template-columns: 30px minmax(0,1fr) 42px 30px; align-items: center; gap: 5px; padding: 5px 7px; border-bottom: 1px solid rgba(215,173,53,.1); }.whiteboard-students-list > div > span { width: 27px; height: 27px; border-radius: 50%; display: grid; place-items: center; border: 1px solid #8d6026; color: #e7bd63; }.whiteboard-students-list strong { color: #f1e5cd; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.whiteboard-students-list b { text-align: center; color: #e8ba5d; }.whiteboard-students-list button { width: 27px; height: 27px; border-radius: 6px; border: 0; background: #d6a33e; color: #1a1107; display: grid; place-items: center; }
.whiteboard-motto { min-height: 100px; display: grid; place-content: center; gap: 3px; text-align: center; color: #dcb05a; border-top: 1px solid rgba(215,173,53,.16); }.whiteboard-motto span { color: #bca783; }.whiteboard-book-mark { font-size: 1.7rem; }
.whiteboard-reference-footer { min-height: 62px; display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 9px 15px; border: 1px solid rgba(215,173,53,.25); border-radius: 0 0 15px 15px; background: #0b0907; }.whiteboard-reference-footer button { min-height: 38px; display: inline-flex; align-items: center; gap: 7px; border-radius: 8px; border: 1px solid rgba(215,173,53,.24); color: #e5bd68; background: transparent; }.whiteboard-reference-footer span { color: #a89777; }

@media (max-width: 1320px) {
  .dashboard-reference-hero { grid-template-columns: 1.1fr .9fr; }
  .dashboard-today-panel { grid-column: 1/-1; display: grid; grid-template-columns: 230px minmax(0,1fr) 190px; align-items: center; }
  .dashboard-today-head { border-bottom: 0; border-left: 1px solid rgba(215,173,53,.13); padding-left: 15px; }
  .dashboard-today-list { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .dashboard-feature-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
  .dashboard-feature-card { min-height: 190px; }
  .whiteboard-reference-layout { grid-template-columns: 82px minmax(0,1fr) 245px; }
}
@media (max-width: 980px) {
  .dashboard-reference-hero { grid-template-columns: 1fr; }
  .dashboard-reference-portrait { min-height: 360px; }
  .dashboard-today-panel { grid-column: auto; display: block; }
  .dashboard-today-head { border-left: 0; border-bottom: 1px solid rgba(215,173,53,.13); }
  .dashboard-reference-bottom { grid-template-columns: 1fr; }
  .whiteboard-reference-header { grid-template-columns: 1fr 1fr; }.whiteboard-title-plaque { grid-column: 1/-1; grid-row: 1; }.whiteboard-reference-layout { grid-template-columns: 76px minmax(0,1fr); }.whiteboard-students-panel { grid-column: 1/-1; max-height: 330px; }.whiteboard-students-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); }.whiteboard-reference-footer { flex-wrap: wrap; }
}
@media (max-width: 800px) {
  .dashboard-reference-layout { padding: 0 8px 12px; }
