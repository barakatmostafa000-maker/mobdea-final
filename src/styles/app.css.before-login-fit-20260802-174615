.gis-palette-chip {
  min-width: 156px; text-align: start; border-radius: 16px; padding: 12px; cursor: grab;
  border: 1px solid rgba(255,255,255,0.08); background: rgba(9,12,18,0.9); color: #fff; position: relative;
}
.gis-palette-chip::before { content: ''; position: absolute; inset: 0; border-radius: inherit; border: 1px solid var(--chip-color); opacity: 0.2; pointer-events: none; }
.gis-palette-chip strong { display: block; color: #f3d48f; margin-bottom: 3px; }
.gis-palette-chip small { color: #d9caa8; line-height: 1.5; }
.gis-map-wrap.build-mode { position: relative; overflow: hidden; }
.gis-placement-layer { position: absolute; inset: 0; pointer-events: none; }
.gis-placement-chip {
  position: absolute; transform: translate(-50%, -50%); min-width: 140px; padding: 8px 10px; border-radius: 14px;
  background: rgba(7,10,16,0.84); border: 1px solid var(--chip-color); color: #fff; text-align: center;
