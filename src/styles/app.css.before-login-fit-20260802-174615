@import "./whiteboard-reference.css";
@import "./maps-reference.css";

:root{
  font-family:Tahoma,Arial,sans-serif;
  color:#152033;
  background:#f3f5f8;
  --gold:#d7ad35;
  --gold-dark:#a87712;
  --dark:#0b0d12;
  --nav:#131925;
  --panel:#ffffff;
  --line:#e4e8ef;
  --muted:#748095;
}
*{box-sizing:border-box}
html,body,#root{margin:0;min-height:100%;background:#f3f5f8}
button,input{font:inherit}
button{cursor:pointer}
.app-shell{display:grid;grid-template-columns:270px minmax(0,1fr);min-height:100vh}
.app-shell.lesson-mode-shell{display:block;min-height:100vh;min-height:100dvh}
.sidebar{background:linear-gradient(180deg,#090c12,#171f2e);color:#fff;padding:20px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;z-index:50}
.brand-panel{display:flex;align-items:center;gap:12px;padding:8px 4px 20px;border-bottom:1px solid #ffffff14}
.brand-mark{width:56px;height:56px;border-radius:18px;background:linear-gradient(145deg,var(--gold),#8c6109);display:grid;place-items:center;font-size:28px;font-weight:900;color:#111}
.brand-panel h1{margin:0;color:#f1d77a}.brand-panel p{margin:3px 0 0;color:#c7cfda}
.drawer-close{display:none}
.sidebar nav{display:grid;gap:5px;margin-top:20px}
.sidebar nav button{display:flex;align-items:center;gap:11px;border:0;background:transparent;color:#e7ecf3;padding:12px 13px;border-radius:12px;text-align:right}
.sidebar nav button:hover,.sidebar nav button.active{background:linear-gradient(90deg,#b88417,#dfbd50);color:#121212}
.sidebar-footer{margin-top:auto;padding:14px;border-radius:14px;background:#ffffff08;display:grid;gap:4px}
.sidebar-footer span{font-size:11px;color:#aeb9c8}
.mobile-header{display:none}
.app-content{padding:24px;min-width:0}
.page{max-width:1500px;margin:auto}
.page-heading{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:18px}
.page-heading h2{margin:4px 0 6px;font-size:30px}.page-heading p{margin:0;color:var(--muted)}
.eyebrow{color:#a87712;font-weight:800;font-size:12px}
.date-chip{background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px 14px;color:#657084}
.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-bottom:15px}
.stat-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;display:flex;gap:13px;align-items:center;box-shadow:0 8px 24px #0000000a}
.stat-icon{width:50px;height:50px;border-radius:15px;background:#111827;display:grid;place-items:center;font-size:24px}
.stat-card span,.stat-card small{display:block;color:var(--muted);font-size:12px}.stat-card strong{display:block;font-size:27px;margin:2px 0}
.dashboard-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:15px}
.panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:17px;box-shadow:0 8px 24px #0000000a}
.current-session{background:radial-gradient(circle at top right,#d7ad3525,transparent 35%),linear-gradient(145deg,#101723,#24334a);color:#fff}
.current-session h3{font-size:25px;margin:10px 0 6px}.current-session p{color:#c7d0db}
.live-badge{color:#f2cf62;font-size:12px}
.quick-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-top:18px}
.quick-actions button,.primary-btn{border:0;border-radius:11px;padding:11px 13px;background:linear-gradient(145deg,#dfbd50,#a87712);font-weight:800;color:#17120a}
.panel-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.panel-title h3{margin:0}.panel-title button,.text-btn{border:0;background:transparent;color:#a87712;font-weight:700}
.student-list{display:grid;gap:9px}.student-row{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:11px;border:1px solid #edf0f4;border-radius:12px}
.student-row strong,.student-row small{display:block}.student-row small{color:var(--muted);margin-top:3px}
.student-code{width:34px;height:34px;border-radius:10px;background:#111827;color:#f2cf62;display:inline-grid;place-items:center;font-weight:900}
.status-pill{background:#f0f3f7;color:#667083;border-radius:20px;padding:6px 9px;font-size:11px}
.search-input{width:100%;padding:12px;border:1px solid var(--line);border-radius:11px;margin-bottom:12px}
.responsive-table{overflow:auto}table{width:100%;border-collapse:collapse}th,td{padding:11px;border-bottom:1px solid #edf0f4;text-align:right;white-space:nowrap}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-grid input{padding:11px;border:1px solid var(--line);border-radius:10px}
.modal-backdrop{position:fixed;inset:0;background:#0009;display:grid;place-items:center;padding:18px;z-index:100}
.modal-card{background:#fff;border-radius:19px;padding:20px;width:min(650px,100%)}.modal-card h3{margin-top:0}
.modal-actions{display:flex;gap:9px;margin-top:15px}.secondary-btn{border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px 14px}
.attendance-list{display:grid;gap:9px}.attendance-row{display:grid;grid-template-columns:auto minmax(170px,1fr) auto;gap:10px;align-items:center;border:1px solid #edf0f4;border-radius:13px;padding:12px}
.attendance-name strong,.attendance-name small{display:block}.attendance-name small{color:var(--muted)}
.attendance-actions{display:flex;gap:6px;flex-wrap:wrap}.attendance-actions button{border:1px solid var(--line);border-radius:9px;padding:8px 10px;background:#fff}
.present-btn.selected{background:#daf6e7;color:#087845;border-color:#7dd8ab}.late-btn.selected{background:#fff3d1;color:#8e6500;border-color:#edca6e}.absent-btn.selected{background:#ffe3e3;color:#a22828;border-color:#ef9999}
.whatsapp-btn{background:#e4f8eb!important;color:#087845!important}
.empty-state,.empty-module{text-align:center;color:var(--muted);padding:35px}.empty-module>div{font-size:48px}
.danger-btn{background:#ffe7e7;color:#a22323;border:0;border-radius:10px;padding:11px 14px}
.loading-screen{min-height:100vh;background:radial-gradient(circle at top,#26334a,#090c12 58%);color:#fff;display:grid;place-content:center;text-align:center}.loading-mark{width:100px;height:100px;border-radius:30px;background:linear-gradient(145deg,var(--gold),#8c6109);display:grid;place-items:center;margin:auto;font-size:50px;font-weight:900;color:#111}.loading-screen h1{color:#f1d77a}
.drawer-overlay{display:none}

@media(max-width:1100px){
  .app-shell{grid-template-columns:220px minmax(0,1fr)}
  .sidebar{padding:15px}
  .stats-grid{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:800px){
  .app-shell{display:block}
  .mobile-header{display:flex;position:sticky;top:0;z-index:40;background:#0d111a;color:#fff;align-items:center;gap:12px;padding:10px 13px}
  .mobile-header>button{width:42px;height:42px;border-radius:11px;border:1px solid #ffffff1f;background:#ffffff0b;color:#fff}
  .mobile-header>div{display:grid}.mobile-header span{font-size:10px;color:#bac4d1}
  .sidebar{position:fixed;right:0;top:0;width:min(86vw,330px);height:100vh;transform:translateX(105%);transition:.25s;box-shadow:-20px 0 50px #0008}
  .sidebar.open{transform:translateX(0)}
  .drawer-overlay{display:block;position:fixed;inset:0;border:0;background:#0009;z-index:45}
  .drawer-close{display:block;margin-right:auto;border:0;background:transparent;color:#fff}
  .app-content{padding:13px}
  .page-heading{flex-direction:column}.page-heading h2{font-size:24px}
  .dashboard-grid{grid-template-columns:1fr}
  .attendance-row{grid-template-columns:auto 1fr}.attendance-actions{grid-column:1/-1}
}

@media(max-width:560px){
  .stats-grid{grid-template-columns:1fr}
  .form-grid{grid-template-columns:1fr}
  .quick-actions{grid-template-columns:1fr 1fr}
}

