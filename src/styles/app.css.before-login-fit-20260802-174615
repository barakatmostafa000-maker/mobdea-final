  gap: 6px;
}

.live-student-join-card label span {
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.78rem;
  font-weight: 700;
}

.live-student-join-card input,
.live-chat-compose input {
  width: 100%;
  color: #fff;
  border-color: rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.07);
}

.live-join-code {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 11px 14px;
  border: 1px dashed rgba(215, 173, 53, 0.55);
  border-radius: 12px;
  color: rgba(255, 255, 255, 0.68);
}

.live-join-code strong {
  color: #f3d77c;
  font-size: 1.35rem;
  letter-spacing: 0.18em;
}

.live-student-topbar {
  justify-content: space-between;
  padding: 10px 14px;
  border-color: rgba(215, 173, 53, 0.3);
  background: rgba(13, 15, 20, 0.96);
}

.live-student-brand img {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  object-fit: contain;
}

.live-student-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
  gap: 12px;
  height: calc(100dvh - 112px);
  margin-top: 10px;
}

.live-student-stage {
  position: relative;
  min-width: 0;
  min-height: 0;
  display: grid;
  place-items: center;
  overflow: hidden;
  padding: 0;
  border-color: rgba(215, 173, 53, 0.3);
  background: #050607;
}

.live-student-stage video,
.live-state-snapshot {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
  background: #050607;
}

.live-waiting-stage {
  display: grid;
  place-items: center;
  gap: 8px;
  text-align: center;
  color: rgba(255, 255, 255, 0.66);
}

.live-waiting-stage h3 {
  margin: 6px 0 0;
  color: #fff;
}

.live-waiting-stage p {
  margin: 0;
}

.live-stage-caption {
  position: absolute;
  right: 12px;
  bottom: 12px;
  left: 12px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  padding: 8px 12px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 12px;
  background: rgba(6, 8, 12, 0.82);
  backdrop-filter: blur(8px);
}

.live-stage-caption span,
.live-stage-caption small {
  color: #f2d77f;
  font-size: 0.75rem;
}

.live-stage-caption strong {
  overflow: hidden;
  color: #fff;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.live-student-controls {
  min-height: 0;
  display: grid;
  align-content: start;
  gap: 10px;
  overflow: auto;
}

.live-student-controls .panel {
  border-color: rgba(215, 173, 53, 0.23);
  background: rgba(15, 17, 23, 0.96);
}

.live-student-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 7px;
}

.live-reaction-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 5px;
  margin-top: 9px;
}

.live-reaction-row button {
  min-height: 38px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.06);
  font-size: 1.15rem;
}

.live-mic-status {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 9px;
  padding: 8px;
  border-radius: 10px;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.05);
}

.live-chat-panel {
  min-height: 220px;
  display: grid;
  grid-template-rows: auto minmax(100px, 1fr) auto;
}

.live-chat-list {
  display: grid;
  align-content: start;
  gap: 6px;
  max-height: 230px;
  overflow: auto;
  padding: 5px 0;
}

.live-chat-list > div {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  width: fit-content;
  max-width: 92%;
  padding: 7px 9px;
  border-radius: 10px 10px 3px 10px;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.08);
  font-size: 0.78rem;
}

.live-chat-list > div.mine {
  margin-inline-start: auto;
  border-radius: 10px 10px 10px 3px;
  color: #18130a;
  background: #d7ad35;
}

.live-chat-compose {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 6px;
}

.live-student-notice {
  color: #fff;
  background: rgba(37, 99, 235, 0.23);
}

.live-student-error {
  width: min(520px, 100%);
  margin: 12vh auto 0;
  text-align: center;
  background: rgba(15, 17, 23, 0.96);
}

@media (max-width: 900px) {
  .live-student-layout {
    grid-template-columns: minmax(0, 1fr) 280px;
  }

  .live-broadcast-actions {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .classmode-media-navigator {
    grid-template-columns: 36px minmax(0, 1fr) 36px;
    margin-inline: 6px;
  }

  .classmode-media-navigator-center {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .classmode-media-navigator-center > svg {
    display: none;
  }

  .live-student-page {
    padding: 6px;
  }

  .live-student-topbar {
    align-items: flex-start;
  }

  .live-student-top-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .live-student-layout {
    grid-template-columns: minmax(0, 1fr) minmax(235px, 42vw);
    height: calc(100dvh - 100px);
  }

  .live-stage-caption {
    right: 6px;
    bottom: 6px;
    left: 6px;
  }
}

@media (orientation: portrait) and (max-width: 720px) {
  .live-student-layout {
    grid-template-columns: 1fr;
    height: auto;
  }

  .live-student-stage {
    min-height: 52dvh;
  }

  .live-student-controls {
    overflow: visible;
  }
}

/* === Online multiplayer games === */
.online-game-host-panel {
  display: grid;
  gap: 12px;
  margin-top: 14px;
  border-color: rgba(215, 173, 53, 0.3);
  background:
    radial-gradient(circle at top left, rgba(215, 173, 53, 0.12), transparent 36%),
    var(--panel, #fff);
}

.online-game-host-title,
.online-game-scoreboard-head,
.online-game-launch-row,
.online-game-room-strip,
.online-game-waiting,
.online-game-question-meta,
.online-game-score-row,
.online-game-student-header,
.online-game-student-header > div,
.online-game-student-metrics {
  display: flex;
  align-items: center;
}

.online-game-host-title,
.online-game-launch-row,
.online-game-question-meta,
.online-game-student-header {
  justify-content: space-between;
}

.online-game-host-title p,
.online-game-launch-row small,
.online-game-waiting span,
.online-game-score-row small,
.online-game-student-header p {
  display: block;
  margin: 3px 0 0;
  color: var(--muted, #777);
  font-size: 0.78rem;
}

.online-game-launch-row {
  gap: 12px;
  padding: 12px;
  border: 1px dashed rgba(215, 173, 53, 0.4);
  border-radius: 14px;
}

.online-game-room-strip {
  flex-wrap: wrap;
  gap: 8px;
  padding: 10px;
  border-radius: 14px;
  background: rgba(215, 173, 53, 0.08);
}

.online-game-room-strip > div {
  min-width: 105px;
  display: grid;
  gap: 2px;
  padding: 7px 10px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.75);
}

.online-game-room-strip > div span {
  color: var(--muted, #777);
  font-size: 0.7rem;
}

.online-game-room-strip > div strong {
  font-size: 1.08rem;
  letter-spacing: 0.04em;
}

.online-game-room-strip .secondary-btn {
  text-decoration: none;
}

.online-game-waiting,
.online-game-finished {
  gap: 12px;
  padding: 16px;
  border: 1px solid rgba(215, 173, 53, 0.24);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.62);
}

.online-game-waiting > div {
  min-width: 0;
  flex: 1;
}

.online-game-current-question {
  display: grid;
  gap: 10px;
  padding: 14px;
  border-radius: 14px;
  color: #fff;
  background: linear-gradient(135deg, #18140d, #30250f);
}

.online-game-current-question h4 {
  margin: 0;
  font-size: clamp(1rem, 2vw, 1.4rem);
}

.online-game-answer-progress {
  width: fit-content;
  padding: 6px 9px;
  border-radius: 999px;
  color: #f8dc7e;
  background: rgba(255, 255, 255, 0.09);
  font-size: 0.76rem;
}

.online-game-finished {
  display: grid;
  place-items: center;
  text-align: center;
}

.online-game-finished h4 {
  margin: 0;
}

.online-game-scoreboard,
.online-game-student-scoreboard {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 6px;
}

.online-game-scoreboard-head {
  gap: 7px;
  margin-bottom: 3px;
}

.online-game-score-row {
  min-width: 0;
  gap: 8px;
  padding: 8px 10px;
  border: 1px solid rgba(0, 0, 0, 0.07);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.72);
}

.online-game-score-row.current {
  border-color: rgba(215, 173, 53, 0.72);
  background: rgba(215, 173, 53, 0.13);
}

.online-game-score-row > div {
  min-width: 0;
  flex: 1;
}

.online-game-score-row > div strong,
.online-game-score-row > div small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.online-game-score-row > b {
  min-width: 50px;
  text-align: end;
  color: #9d7411;
}

.online-game-rank {
  width: 34px;
  color: #9d7411;
  font-weight: 800;
}

.online-game-close {
  justify-self: start;
}

.online-game-student-page {
  min-height: 100dvh;
  padding: 10px;
  color: #fff;
  background:
    radial-gradient(circle at 20% 0%, rgba(215, 173, 53, 0.2), transparent 34%),
    #08090c;
}

.online-game-student-shell {
  width: min(1280px, 100%);
  margin: 0 auto;
}

.online-game-student-header {
  gap: 12px;
  margin-bottom: 10px;
  border-color: rgba(215, 173, 53, 0.28);
  background: rgba(17, 19, 25, 0.96);
}

.online-game-student-header > div {
  gap: 9px;
}

.online-game-student-header h2 {
  margin: 0;
  color: #fff;
}

.online-game-student-metrics {
  gap: 8px;
}

.online-game-student-metrics span {
  min-width: 86px;
  display: grid;
  gap: 2px;
  padding: 7px 10px;
  border-radius: 10px;
  color: rgba(255, 255, 255, 0.68);
  background: rgba(255, 255, 255, 0.06);
  font-size: 0.7rem;
  text-align: center;
}

.online-game-student-metrics strong {
  color: #f0cf68;
  font-size: 1rem;
}

.online-game-student-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(240px, 310px);
  gap: 10px;
  height: calc(100dvh - 108px);
}

.online-game-question-card,
.online-game-student-scoreboard,
.online-game-ended-card {
  border-color: rgba(215, 173, 53, 0.24);
  background: rgba(15, 17, 23, 0.97);
}

.online-game-question-card {
  min-height: 0;
  display: grid;
  align-content: center;
  gap: 14px;
  overflow: auto;
}

.online-game-question-card h3 {
  margin: 0;
  color: #fff;
  font-size: clamp(1.2rem, 3vw, 2rem);
  line-height: 1.5;
  text-align: center;
}

.online-game-question-meta {
  color: #e8ca6c;
}

.online-game-question-meta .danger {
  color: #ff8c8c;
}

.online-game-student-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.online-game-student-options button {
  min-height: 64px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 13px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 14px;
  color: #fff;
  background: rgba(255, 255, 255, 0.07);
  font: inherit;
  text-align: start;
}

.online-game-student-options button > span {
  width: 30px;
  height: 30px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 9px;
  color: #17120a;
  background: #d7ad35;
  font-weight: 900;
}

.online-game-student-options button.selected {
  border-color: #d7ad35;
  box-shadow: 0 0 0 2px rgba(215, 173, 53, 0.15);
}

.online-game-student-options button.correct {
  border-color: #4ade80;
  background: rgba(34, 197, 94, 0.2);
}

.online-game-student-options button.wrong {
  border-color: #f87171;
  background: rgba(239, 68, 68, 0.2);
}

.online-game-answer-result {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 11px;
}

.online-game-answer-result.correct {
  color: #bbf7d0;
  background: rgba(34, 197, 94, 0.18);
}

.online-game-answer-result.wrong {
  color: #fecaca;
  background: rgba(239, 68, 68, 0.18);
}

.online-game-student-scoreboard {
  min-height: 0;
  overflow: auto;
}

.online-game-student-scoreboard .online-game-score-row {
  color: #fff;
  border-color: rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.05);
}

.online-game-student-waiting,
.online-game-ended-card {
  display: grid;
  place-items: center;
  gap: 8px;
  text-align: center;
}

.online-game-student-waiting h3,
.online-game-ended-card h3 {
  margin: 0;
  color: #fff;
}

.online-game-student-waiting p,
.online-game-ended-card p {
  margin: 0;
  color: rgba(255, 255, 255, 0.66);
}

.online-game-ended-card {
  min-height: 55dvh;
}

.online-game-student-notice {
  margin-top: 8px;
  color: #fff;
  background: rgba(37, 99, 235, 0.2);
}

.online-game-join-card header img {
  object-fit: contain;
}

@media (max-width: 760px) {
  .online-game-student-page {
    padding: 5px;
  }

  .online-game-student-header {
    padding: 8px;
  }

  .online-game-student-grid {
    grid-template-columns: minmax(0, 1fr) minmax(190px, 34vw);
    height: calc(100dvh - 91px);
  }

  .online-game-question-card {
    padding: 10px;
  }

  .online-game-student-options {
    gap: 6px;
  }

  .online-game-student-options button {
    min-height: 48px;
    padding: 7px;
    font-size: 0.78rem;
  }

  .online-game-student-options button > span {
    width: 24px;
    height: 24px;
  }
}

@media (orientation: portrait) and (max-width: 720px) {
  .online-game-student-grid {
    grid-template-columns: 1fr;
    height: auto;
  }

  .online-game-question-card {
    min-height: 58dvh;
  }

  .online-game-student-scoreboard {
    max-height: 35dvh;
  }
}

/* === Permission-aware global search === */
.sidebar-search-button {
  width: 100%;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  margin-top: 9px;
  padding: 9px 10px;
  border: 1px solid rgba(215, 173, 53, 0.22);
  border-radius: 12px;
  color: inherit;
  background: rgba(215, 173, 53, 0.07);
  text-align: start;
}

.sidebar-search-button > span {
  min-width: 0;
  display: grid;
}

.sidebar-search-button strong,
.sidebar-search-button small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-search-button small {
  color: var(--muted, #888);
  font-size: 0.68rem;
}

.sidebar-search-button kbd {
  padding: 3px 5px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 6px;
  color: var(--muted, #999);
  background: rgba(255, 255, 255, 0.05);
  font: 0.6rem/1 inherit;
}

.sidebar.collapsed .sidebar-search-button {
  grid-template-columns: 1fr;
  justify-items: center;
}

.sidebar.collapsed .sidebar-search-button > span,
.sidebar.collapsed .sidebar-search-button kbd {
  display: none;
}

.global-search-backdrop {
  position: fixed;
  z-index: 5000;
  inset: 0;
  display: grid;
  place-items: start center;
  padding: min(12vh, 90px) 12px 12px;
  background: rgba(3, 5, 9, 0.68);
  backdrop-filter: blur(8px);
}

.global-search-dismiss {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  background: transparent;
}

.global-search-panel {
  position: relative;
  z-index: 1;
  width: min(720px, 100%);
  max-height: min(650px, 78dvh);
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
  border: 1px solid rgba(215, 173, 53, 0.32);
  border-radius: 18px;
  background: #111319;
  box-shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
}

.global-search-input-row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  padding: 12px 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  color: #d7ad35;
}

.global-search-input-row input {
  min-width: 0;
  border: 0;
  outline: 0;
  color: #fff;
  background: transparent;
  font: inherit;
  font-size: 1rem;
}

.global-search-input-row input::placeholder {
  color: rgba(255, 255, 255, 0.42);
}

.global-search-input-row button {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 9px;
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
}

.global-search-results {
  min-height: 220px;
  overflow: auto;
  padding: 8px;
}

.global-search-result {
  width: 100%;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border: 1px solid transparent;
  border-radius: 12px;
  color: #fff;
  background: transparent;
  text-align: start;
}

.global-search-result:hover,
.global-search-result:focus-visible {
  border-color: rgba(215, 173, 53, 0.28);
  outline: 0;
  background: rgba(215, 173, 53, 0.08);
}

.global-search-result-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: #f3d675;
  background: rgba(215, 173, 53, 0.12);
}

.global-search-result > span:nth-child(2) {
  min-width: 0;
  display: grid;
  gap: 2px;
}

.global-search-result strong,
.global-search-result small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.global-search-result small {
  color: rgba(255, 255, 255, 0.58);
  font-size: 0.74rem;
}

.global-search-result em {
  padding: 4px 7px;
  border-radius: 999px;
  color: #e9cd72;
  background: rgba(255, 255, 255, 0.06);
  font-size: 0.66rem;
  font-style: normal;
}

.global-search-empty {
  min-height: 230px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 6px;
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
}

.global-search-empty strong {
  color: #fff;
}

.global-search-empty span {
  font-size: 0.76rem;
}

@media (max-width: 720px) {
  .global-search-backdrop {
    padding-top: 8px;
  }

  .global-search-panel {
    max-height: calc(100dvh - 16px);
    border-radius: 14px;
  }
}

/* === Achievements, levels and reward store === */
.achievements-page {
  display: grid;
  gap: 14px;
}

.achievements-hero {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 18px;
  overflow: hidden;
  border-color: rgba(215, 173, 53, 0.32);
  background:
    radial-gradient(circle at 8% 20%, rgba(215, 173, 53, 0.24), transparent 27%),
    linear-gradient(135deg, #15120c, #2b220f);
  color: #fff;
}

.achievements-level-orb {
  width: 104px;
  height: 104px;
  display: grid;
  place-items: center;
  align-content: center;
  border: 2px solid rgba(245, 216, 115, 0.68);
  border-radius: 50%;
  color: #f5d873;
  background: rgba(255, 255, 255, 0.06);
  box-shadow: inset 0 0 24px rgba(215, 173, 53, 0.18);
}

.achievements-level-orb strong {
  font-size: 1.7rem;
  line-height: 1;
}

.achievements-level-orb span {
  font-size: 0.68rem;
}

.achievements-hero-copy h3 {
  margin: 3px 0 9px;
  font-size: clamp(1.3rem, 2.4vw, 2rem);
}

.achievements-progress {
  height: 11px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
}

.achievements-progress i {
  height: 100%;
  display: block;
  border-radius: inherit;
  background: linear-gradient(90deg, #b98a19, #f5d873);
}

.achievements-hero-copy small {
  display: block;
  margin-top: 7px;
  color: rgba(255, 255, 255, 0.66);
}

.achievements-quick-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(85px, 1fr));
  gap: 7px;
}

.achievements-quick-stats span {
  display: grid;
  justify-items: center;
  gap: 2px;
  padding: 9px;
  border-radius: 12px;
  color: #f0d474;
  background: rgba(255, 255, 255, 0.07);
  text-align: center;
}

.achievements-quick-stats small {
  color: rgba(255, 255, 255, 0.58);
  font-size: 0.65rem;
}

.achievements-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(330px, 0.85fr);
  gap: 14px;
}

.achievements-badge-grid,
.reward-catalog-grid,
.reward-request-list {
  display: grid;
  gap: 8px;
}

.achievements-badge-grid {
  grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
}

.achievement-badge {
  display: grid;
  justify-items: center;
  gap: 4px;
  padding: 14px 9px;
  border: 1px solid rgba(215, 173, 53, 0.2);
  border-radius: 14px;
  background: rgba(215, 173, 53, 0.06);
  text-align: center;
}

.achievement-badge > span {
  font-size: 2rem;
}

.achievement-badge small {
  color: var(--muted, #777);
  font-size: 0.68rem;
}

.reward-card {
  position: relative;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  padding: 9px;
  border: 1px solid rgba(0, 0, 0, 0.07);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.62);
}

.reward-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: #9a7214;
  background: rgba(215, 173, 53, 0.15);
}

.reward-card > div {
  min-width: 0;
  display: grid;
}

.reward-card small {
  color: #9a7214;
  font-weight: 700;
}

.reward-remove {
  width: 34px;
  height: 34px;
  padding: 0;
}

.reward-view-only {
  color: var(--muted, #777);
  font-size: 0.7rem;
}

.reward-add-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 100px auto;
  gap: 7px;
  margin-top: 10px;
}

.reward-add-form input {
  min-width: 0;
}

.reward-request-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 9px 10px;
  border: 1px solid rgba(0, 0, 0, 0.07);
  border-radius: 12px;
}

.reward-request-row > div:first-child {
  min-width: 0;
  display: grid;
}

.reward-request-row small {
  color: var(--muted, #777);
}

.reward-request-row > div:last-child {
  display: flex;
  gap: 6px;
}

.reward-request-row .primary-btn,
.reward-request-row .danger-btn,
.reward-request-row .secondary-btn {
  min-height: 35px;
  padding: 7px 9px;
}

.achievements-notice {
  position: sticky;
  bottom: 10px;
  z-index: 5;
}

@media (max-width: 900px) {
  .achievements-hero {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .achievements-quick-stats {
    grid-column: 1 / -1;
  }

  .achievements-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .achievements-level-orb {
    width: 82px;
    height: 82px;
  }

  .achievements-quick-stats {
    grid-template-columns: repeat(3, 1fr);
  }

  .reward-add-form {
    grid-template-columns: 1fr 90px;
  }

  .reward-add-form button {
    grid-column: 1 / -1;
  }

  .reward-request-row {
    align-items: stretch;
    flex-direction: column;
  }
}

/* =========================================================
